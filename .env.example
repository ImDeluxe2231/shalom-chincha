# Copia este archivo como .env. No publiques el archivo .env real.
DEBUG=True
PRODUCTION=False
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# SQLite para desarrollo; MySQL es opcional.
DB_ENGINE=sqlite
DB_NAME=shalom_chincha
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# En desarrollo, los correos se muestran en la consola.
NOTIFICATIONS_EMAIL_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Shalom Chincha <no-responder@shalom-chincha.test>
